#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Rosalia Labs LLC
#
# Human-friendly query/subset/archive tool for the uploaded audio archive.
#
# SCOPE: today there is exactly one classifier (BirdNET), so this queries its
# schema directly (sensos.birdnet_detections) rather than through any kind of
# classifier-agnostic abstraction -- a generic "pluggable schema" layer isn't
# worth building for a single concrete schema. If/when a second classifier
# with its own detection schema shows up, this will need either a second
# query path or a real abstraction over "detection source"; don't assume the
# column names and single-table queries below generalize as-is.
#
# Detection metadata lives in Postgres, reached the same way bin/client-overview
# reaches it -- `docker exec sensos-database psql` -- since Postgres isn't
# published to the host. Audio clips live on disk under BIRDNET_AUDIO_DATA_DIR
# (docker/.env), which is a host bind mount of the same tree the controller
# container writes to, so clip files are read directly off the host
# filesystem rather than through docker exec/cp.

from __future__ import annotations

import argparse
import csv
import io
import json
import re
import shutil
import sqlite3
import subprocess
import sys
import tarfile
import zipfile
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
DOCKER_DIR = REPO_ROOT / "docker"
ENV_FILE = DOCKER_DIR / ".env"
DB_CONTAINER = "sensos-database"
CONTROLLER_CONTAINER = "sensos-controller"
DEFAULT_AUDIO_DIR = REPO_ROOT / "local" / "birdnet-audio"

BASE_COLUMNS = """
           d.id AS detection_id,
           d.peer_id,
           d.wireguard_ip::text AS wg_ip,
           COALESCE(NULLIF(p.note, ''), host(d.wireguard_ip)) AS site_label,
           n.name AS network_name,
           d.hostname,
           d.channel_index,
           d.window_index,
           d.label,
           d.score,
           d.likely_score,
           d.weighted_label,
           d.weighted_score,
           d.weighted_likely_score,
           d.volume,
           d.clip_start_time,
           d.clip_end_time,
           d.clip_path,
           d.server_received_at,
           loc.lat,
           loc.lon
"""

BASE_FROM = """
    FROM sensos.birdnet_detections d
    JOIN sensos.wireguard_peers p ON p.id = d.peer_id
    JOIN sensos.networks n ON n.id = p.network_id
    LEFT JOIN LATERAL (
        SELECT ST_Y(location::geometry) AS lat, ST_X(location::geometry) AS lon
        FROM sensos.peer_locations
        WHERE peer_id = d.peer_id AND recorded_at <= d.clip_start_time
        ORDER BY recorded_at DESC
        LIMIT 1
    ) loc ON TRUE
"""

BASE_SELECT = f"SELECT{BASE_COLUMNS}{BASE_FROM}"

EFFECTIVE_LABEL_EXPR = "COALESCE(d.weighted_label, d.label)"

MANIFEST_FIELDS = [
    "detection_id",
    "peer_id",
    "site_label",
    "network_name",
    "hostname",
    "channel_index",
    "label",
    "score",
    "likely_score",
    "weighted_label",
    "weighted_score",
    "weighted_likely_score",
    "volume",
    "clip_start_time",
    "clip_end_time",
    "lat",
    "lon",
    "archive_path",
]

ENVIRONMENT_FIELDS = [
    "detection_id",
    "peer_id",
    "device_address",
    "sensor_type",
    "reading_key",
    "reading_value",
    "recorded_at",
    "offset_seconds",
]


def die(message: str) -> None:
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_env() -> dict[str, str]:
    env: dict[str, str] = {}
    if ENV_FILE.is_file():
        for line in ENV_FILE.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            env[key.strip()] = value.strip().strip('"').strip("'")
    return env


def require_docker() -> None:
    if shutil.which("docker") is None:
        die("docker binary not found")
    try:
        subprocess.run(["docker", "info"], capture_output=True, check=True, timeout=10)
    except Exception:
        die("docker access unavailable for the current user")


def require_container_running(name: str) -> None:
    result = subprocess.run(
        ["docker", "ps", "--filter", f"name=^{name}$", "--format", "{{.Names}}"],
        capture_output=True,
        text=True,
        check=True,
    )
    if name not in result.stdout.split():
        die(f"{name} container is not running")


def require_db_running() -> None:
    require_container_running(DB_CONTAINER)


def psql_raw(env: dict[str, str], sql: str) -> str:
    cmd = [
        "docker",
        "exec",
        "-e",
        f"PGPASSWORD={env.get('POSTGRES_PASSWORD', '')}",
        DB_CONTAINER,
        "psql",
        "-U",
        "postgres",
        "-d",
        "postgres",
        "-X",
        "-A",
        "-t",
        "-P",
        "pager=off",
        "-c",
        sql,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"query failed: {result.stderr.strip()}")
    return result.stdout.strip()


def psql_json(env: dict[str, str], sql: str):
    output = psql_raw(env, sql)
    if not output:
        return None
    return json.loads(output)


def psql_scalar(env: dict[str, str], sql: str) -> str:
    return psql_raw(env, sql)


def sql_literal(value) -> str:
    if value is None:
        return "NULL"
    if isinstance(value, bool):
        return "TRUE" if value else "FALSE"
    if isinstance(value, (int, float)):
        return repr(value)
    text = str(value).replace("'", "''")
    return f"'{text}'"


RELATIVE_RE = re.compile(r"^(\d+)([dhm])$")


def parse_when(value: str) -> datetime:
    """Accepts ISO 8601 ('2026-01-01', '2026-01-01T00:00:00Z') or a shorthand
    relative to now ('7d', '24h', '30m')."""
    match = RELATIVE_RE.match(value.strip())
    if match:
        amount, unit = int(match.group(1)), match.group(2)
        delta = {
            "d": timedelta(days=amount),
            "h": timedelta(hours=amount),
            "m": timedelta(minutes=amount),
        }[unit]
        return datetime.now(timezone.utc) - delta
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        die(
            f"could not parse date/time '{value}' "
            "(expected ISO 8601 like 2026-01-01T00:00:00Z, or Nd/Nh/Nm relative to now)"
        )
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def resolve_site(env: dict[str, str], selector: str) -> tuple[int, str]:
    sql = f"""
        SELECT COALESCE(json_agg(t), '[]'::json) FROM (
            SELECT p.id AS peer_id,
                   COALESCE(NULLIF(p.note, ''), host(p.wg_ip)) AS site_label
            FROM sensos.wireguard_peers p
            LEFT JOIN LATERAL (
                SELECT hostname FROM sensos.client_status
                WHERE peer_id = p.id ORDER BY last_check_in DESC LIMIT 1
            ) ls ON TRUE
            WHERE p.id::text = {sql_literal(selector)}
               OR p.uuid::text = {sql_literal(selector)}
               OR host(p.wg_ip) = {sql_literal(selector)}
               OR lower(COALESCE(ls.hostname, '')) = lower({sql_literal(selector)})
        ) t;
    """
    matches = psql_json(env, sql) or []
    if not matches:
        die(f"no site matches '{selector}' (try bin/client-overview to look up ids/hostnames)")
    if len(matches) > 1:
        print(f"ERROR: site selector '{selector}' is ambiguous:", file=sys.stderr)
        for m in matches:
            print(f"  id={m['peer_id']} label={m['site_label']}", file=sys.stderr)
        raise SystemExit(1)
    return matches[0]["peer_id"], matches[0]["site_label"]


def build_where(env: dict[str, str], args: argparse.Namespace) -> str:
    clauses: list[str] = []
    if args.label:
        clauses.append(f"lower(d.label) = lower({sql_literal(args.label)})")
    if args.weighted_label:
        clauses.append(f"lower(d.weighted_label) = lower({sql_literal(args.weighted_label)})")
    if args.min_score is not None:
        clauses.append(f"d.score >= {args.min_score!r}")
    if args.min_weighted_score is not None:
        clauses.append(f"d.weighted_score >= {args.min_weighted_score!r}")
    if args.channel is not None:
        clauses.append(f"d.channel_index = {args.channel}")
    if args.network:
        clauses.append(f"lower(n.name) = lower({sql_literal(args.network)})")
    if args.site:
        peer_id, _label = resolve_site(env, args.site)
        clauses.append(f"d.peer_id = {peer_id}")
    if args.since:
        clauses.append(f"d.clip_start_time >= {sql_literal(parse_when(args.since).isoformat())}")
    if args.until:
        clauses.append(f"d.clip_start_time < {sql_literal(parse_when(args.until).isoformat())}")
    if getattr(args, "with_audio_only", False):
        clauses.append("d.clip_path IS NOT NULL")
    return " AND ".join(clauses) if clauses else "TRUE"


def fetch_rows(env: dict[str, str], args: argparse.Namespace) -> list[dict]:
    where = build_where(env, args)
    per_label = getattr(args, "per_label", None)
    if per_label is not None and per_label < 1:
        die("--per-label must be >= 1")

    if per_label:
        # Highest-score examples first within each label -- for a teaching/
        # sample archive, the clearest clips are the useful ones, not an
        # arbitrary or most-recent one. Ordering the (optional) global cap by
        # label_rank before score means every label gets its best example
        # before any label gets a second one -- a global --limit thins depth
        # per label rather than dropping whole labels from the end.
        global_limit_clause = ""
        if not args.all and args.limit is not None:
            global_limit_clause = f"LIMIT {args.limit}"
        sql = f"""
            SELECT COALESCE(json_agg(t), '[]'::json) FROM (
                SELECT * FROM (
                    SELECT{BASE_COLUMNS},
                           {EFFECTIVE_LABEL_EXPR} AS effective_label,
                           ROW_NUMBER() OVER (
                               PARTITION BY {EFFECTIVE_LABEL_EXPR}
                               ORDER BY d.score DESC, d.id
                           ) AS label_rank
                    {BASE_FROM}
                    WHERE {where}
                ) ranked
                WHERE ranked.label_rank <= {per_label}
                ORDER BY ranked.label_rank, ranked.score DESC
                {global_limit_clause}
            ) t;
        """
        rows = psql_json(env, sql) or []
        rows.sort(key=lambda r: (r["effective_label"], r["label_rank"]))
        return rows

    order = "DESC" if args.order == "desc" else "ASC"
    limit_clause = "" if args.all else f"LIMIT {args.limit}"
    sql = f"""
        SELECT COALESCE(json_agg(t), '[]'::json) FROM (
            {BASE_SELECT}
            WHERE {where}
            ORDER BY d.clip_start_time {order}
            {limit_clause}
        ) t;
    """
    return psql_json(env, sql) or []


def fetch_environment(env: dict[str, str], rows: list[dict], window_minutes: float) -> list[dict]:
    """i2c_readings has no fixed set of reading_key columns -- it varies by
    whatever sensors are physically attached at a given site -- so this
    returns long/tidy rows (one per reading) rather than trying to pivot to a
    wide table with a column per sensor. Matches every reading at the same
    site within +/- window_minutes of each detection's clip_start_time, not
    just the single nearest one, since different sensors can log on
    different intervals and a human doing analysis can always narrow further."""
    if not rows:
        return []
    targets = ", ".join(
        f"({row['detection_id']}, {row['peer_id']}, {sql_literal(row['clip_start_time'])}::timestamptz)"
        for row in rows
    )
    sql = f"""
        WITH targets (detection_id, peer_id, clip_start_time) AS (
            VALUES {targets}
        )
        SELECT COALESCE(json_agg(t), '[]'::json) FROM (
            SELECT tg.detection_id,
                   r.peer_id,
                   r.device_address,
                   r.sensor_type,
                   r.reading_key,
                   r.reading_value,
                   r.recorded_at,
                   EXTRACT(EPOCH FROM (r.recorded_at - tg.clip_start_time))::int AS offset_seconds
            FROM targets tg
            JOIN sensos.i2c_readings r
              ON r.peer_id = tg.peer_id
             AND r.recorded_at BETWEEN tg.clip_start_time - interval '{window_minutes} minutes'
                                    AND tg.clip_start_time + interval '{window_minutes} minutes'
            ORDER BY tg.detection_id, r.recorded_at
        ) t;
    """
    return psql_json(env, sql) or []


def add_filter_args(parser: argparse.ArgumentParser, *, with_audio_only_flag: bool) -> None:
    parser.add_argument("--label", help="Exact (case-insensitive) match on the raw BirdNET label")
    parser.add_argument(
        "--weighted-label", help="Exact (case-insensitive) match on the location/date-weighted label"
    )
    parser.add_argument("--min-score", type=float, help="Minimum raw score (0-1)")
    parser.add_argument("--min-weighted-score", type=float, help="Minimum weighted score (0-1)")
    parser.add_argument("--site", help="Peer id, UUID, WireGuard IP, or hostname (see bin/client-overview)")
    parser.add_argument("--network", help="Network name")
    parser.add_argument("--channel", type=int, help="Channel index")
    parser.add_argument(
        "--since", help="Only clips starting at/after this time (ISO 8601, or Nd/Nh/Nm relative to now)"
    )
    parser.add_argument("--until", help="Only clips starting before this time (same formats as --since)")
    parser.add_argument(
        "--order", choices=["asc", "desc"], default="desc", help="Order by clip_start_time (default: desc)"
    )
    if with_audio_only_flag:
        parser.add_argument(
            "--with-audio-only", action="store_true", help="Only include detections with an uploaded clip"
        )


def truncate(text: str, width: int) -> str:
    text = text or ""
    if len(text) <= width:
        return text
    return text[: max(0, width - 1)] + "~"


def cmd_query(env: dict[str, str], args: argparse.Namespace) -> None:
    rows = fetch_rows(env, args)
    if args.format == "json":
        json.dump(rows, sys.stdout, indent=2, default=str)
        print()
        return
    if args.format == "csv":
        writer = csv.DictWriter(sys.stdout, fieldnames=list(BASE_ROW_FIELDS))
        writer.writeheader()
        for row in rows:
            writer.writerow({k: row.get(k) for k in BASE_ROW_FIELDS})
        return

    if not rows:
        print("No matching detections.")
        return
    header = f"{'ID':>8} {'SITE':<16} {'CH':>2} {'LABEL':<22} {'SCORE':>6} {'CLIP START':<20} {'AUDIO'}"
    print(header)
    print("-" * len(header))
    for row in rows:
        label = row.get("weighted_label") or row.get("label") or ""
        marker = "" if row.get("weighted_label") else "*"
        score = row.get("weighted_score") if row.get("weighted_label") else row.get("score")
        print(
            f"{row['detection_id']:>8} "
            f"{truncate(row.get('site_label') or '', 16):<16} "
            f"{row.get('channel_index', 0):>2} "
            f"{truncate(label + marker, 22):<22} "
            f"{(score if score is not None else 0):>6.2f} "
            f"{(row.get('clip_start_time') or '')[:19]:<20} "
            f"{'Y' if row.get('clip_path') else 'n'}"
        )
    print(f"\n{len(rows)} row(s). '*' = raw label shown (no weighted label yet).")


BASE_ROW_FIELDS = [
    "detection_id",
    "peer_id",
    "wg_ip",
    "site_label",
    "network_name",
    "hostname",
    "channel_index",
    "window_index",
    "label",
    "score",
    "likely_score",
    "weighted_label",
    "weighted_score",
    "weighted_likely_score",
    "volume",
    "clip_start_time",
    "clip_end_time",
    "clip_path",
    "server_received_at",
    "lat",
    "lon",
]


def cmd_labels(env: dict[str, str], args: argparse.Namespace) -> None:
    clauses = []
    if args.site:
        peer_id, _ = resolve_site(env, args.site)
        clauses.append(f"d.peer_id = {peer_id}")
    if args.since:
        clauses.append(f"d.clip_start_time >= {sql_literal(parse_when(args.since).isoformat())}")
    if args.until:
        clauses.append(f"d.clip_start_time < {sql_literal(parse_when(args.until).isoformat())}")
    where = " AND ".join(clauses) if clauses else "TRUE"
    sql = f"""
        SELECT COALESCE(json_agg(t), '[]'::json) FROM (
            SELECT COALESCE(d.weighted_label, d.label) AS label,
                   count(*)::int AS detections,
                   count(d.clip_path)::int AS with_audio,
                   max(d.clip_start_time) AS latest
            FROM sensos.birdnet_detections d
            WHERE {where}
            GROUP BY 1
            ORDER BY detections DESC
        ) t;
    """
    rows = psql_json(env, sql) or []
    if not rows:
        print("No detections match.")
        return
    header = f"{'LABEL':<28} {'DETECTIONS':>10} {'WITH AUDIO':>10} {'LATEST':<20}"
    print(header)
    print("-" * len(header))
    for row in rows:
        print(
            f"{truncate(row['label'] or '(none)', 28):<28} "
            f"{row['detections']:>10} "
            f"{row['with_audio']:>10} "
            f"{(row.get('latest') or '')[:19]:<20}"
        )
    print("\nLabel is weighted_label when present, else the raw label.")


def human_bytes(n: int) -> str:
    size = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if size < 1024 or unit == "TiB":
            return f"{size:.1f}{unit}"
        size /= 1024
    return f"{size:.1f}TiB"


def read_manifest_detection_ids(manifest_path: Path) -> set[int] | None:
    """None means the manifest.db couldn't be read at all (missing, or
    genuinely broken); an empty set means it exists but has no clips table/
    rows yet -- those are reported differently."""
    if not manifest_path.is_file():
        return None
    try:
        conn = sqlite3.connect(f"file:{manifest_path}?mode=ro", uri=True, timeout=10)
        try:
            return {row[0] for row in conn.execute("SELECT detection_id FROM clips")}
        finally:
            conn.close()
    except sqlite3.OperationalError:
        # Most commonly "no such table: clips" -- a manifest.db that exists
        # but predates any clip ever being written for this peer.
        return set()


def read_clients_db_peer_ids(audio_root: Path) -> set[int]:
    clients_db = audio_root / "clients.db"
    if not clients_db.is_file():
        return set()
    try:
        conn = sqlite3.connect(f"file:{clients_db}?mode=ro", uri=True, timeout=10)
        try:
            return {row[0] for row in conn.execute("SELECT peer_id FROM clients")}
        finally:
            conn.close()
    except sqlite3.OperationalError:
        return set()


def cmd_status(env: dict[str, str], args: argparse.Namespace) -> None:
    """Cross-checks the three places a clip's existence is recorded -- the
    .flac file on disk, the clip_path on its sensos.birdnet_detections row,
    and its entry in that peer's manifest.db -- and reports where they
    disagree. Read-only; doesn't fix anything (that's what `repair` is
    for)."""
    audio_root = Path(env.get("BIRDNET_AUDIO_DATA_DIR") or DEFAULT_AUDIO_DIR)
    if not audio_root.is_dir():
        die(f"audio root not found at {audio_root} (check BIRDNET_AUDIO_DATA_DIR in {ENV_FILE})")

    site_peer_id = None
    if args.site:
        site_peer_id, _label = resolve_site(env, args.site)

    peer_dirs: list[int] = []
    for entry in sorted(audio_root.iterdir()):
        if not entry.is_dir() or not entry.name.isdigit():
            continue
        peer_id = int(entry.name)
        if site_peer_id is not None and peer_id != site_peer_id:
            continue
        peer_dirs.append(peer_id)

    disk_clips: dict[int, dict[int, int]] = {}  # peer_id -> {detection_id: size_bytes}
    total_bytes = 0
    for peer_id in peer_dirs:
        clips: dict[int, int] = {}
        for f in (audio_root / str(peer_id)).glob("*.flac"):
            try:
                detection_id = int(f.stem)
            except ValueError:
                continue
            size = f.stat().st_size
            clips[detection_id] = size
            total_bytes += size
        disk_clips[peer_id] = clips

    manifested: dict[int, set[int]] = {}
    manifest_missing_peers: list[int] = []
    for peer_id in peer_dirs:
        ids = read_manifest_detection_ids(audio_root / str(peer_id) / "manifest.db")
        if ids is None:
            manifest_missing_peers.append(peer_id)
            manifested[peer_id] = set()
        else:
            manifested[peer_id] = ids

    clients_db_peers = read_clients_db_peer_ids(audio_root)

    where = f"d.peer_id = {site_peer_id}" if site_peer_id is not None else "TRUE"
    db_rows = (
        psql_json(
            env,
            f"""
            SELECT COALESCE(json_agg(t), '[]'::json) FROM (
                SELECT d.id AS detection_id, d.peer_id
                FROM sensos.birdnet_detections d
                WHERE d.clip_path IS NOT NULL AND {where}
            ) t;
            """,
        )
        or []
    )
    db_clips: dict[int, set[int]] = defaultdict(set)
    for row in db_rows:
        db_clips[row["peer_id"]].add(row["detection_id"])

    null_clip_count = psql_scalar(
        env, f"SELECT count(*) FROM sensos.birdnet_detections d WHERE d.clip_path IS NULL AND {where};"
    )

    orphaned_files: list[tuple[int, int]] = []
    dangling_db: list[tuple[int, int]] = []
    not_manifested: list[tuple[int, int]] = []
    stale_manifest: list[tuple[int, int]] = []

    all_peer_ids = sorted(set(disk_clips) | set(db_clips))
    for peer_id in all_peer_ids:
        disk_ids = set(disk_clips.get(peer_id, {}))
        db_ids = db_clips.get(peer_id, set())
        manifest_ids = manifested.get(peer_id, set())

        orphaned_files += [(peer_id, i) for i in sorted(disk_ids - db_ids)]
        dangling_db += [(peer_id, i) for i in sorted(db_ids - disk_ids)]
        not_manifested += [(peer_id, i) for i in sorted(disk_ids - manifest_ids)]
        stale_manifest += [(peer_id, i) for i in sorted(manifest_ids - disk_ids)]

    total_disk_clips = sum(len(v) for v in disk_clips.values())
    total_db_clips = sum(len(v) for v in db_clips.values())
    missing_from_clients_db = sorted(set(peer_dirs) - clients_db_peers)

    print("Audio archive status")
    print(f"  audio root: {audio_root}")
    if args.site:
        print(f"  site: {args.site} (peer_id={site_peer_id})")
    print(f"  peer directories: {len(peer_dirs)}")
    print(f"  clip files on disk: {total_disk_clips} ({human_bytes(total_bytes)})")
    print(f"  detections with clip_path set in Postgres: {total_db_clips}")
    print(f"  detections with no clip yet (clip_path NULL): {null_clip_count}")
    print()
    print(f"  orphaned files (on disk, no matching DB row): {len(orphaned_files)}")
    print(f"  dangling DB rows (clip_path set, file missing on disk): {len(dangling_db)}")
    print(f"  not yet manifested (file on disk, missing from that peer's manifest.db): {len(not_manifested)}")
    print(f"  stale manifest rows (in manifest.db, file missing on disk): {len(stale_manifest)}")
    if manifest_missing_peers:
        shown = ", ".join(str(p) for p in manifest_missing_peers[:10])
        more = "..." if len(manifest_missing_peers) > 10 else ""
        print(f"  peer directories with no manifest.db at all: {len(manifest_missing_peers)} ({shown}{more})")
    if missing_from_clients_db:
        shown = ", ".join(str(p) for p in missing_from_clients_db[:10])
        more = "..." if len(missing_from_clients_db) > 10 else ""
        print(f"  peer directories missing from clients.db: {len(missing_from_clients_db)} ({shown}{more})")

    if not_manifested or manifest_missing_peers or stale_manifest:
        print()
        print("  Manifest drift found. Fix with:")
        print("    ./bin/audio-archive repair")
    if dangling_db or orphaned_files:
        print()
        print(
            "  Disk/Postgres mismatch found -- this is NOT what 'repair' fixes (that only "
            "reconciles manifest.db from disk+Postgres); it means the clip file and the "
            "database row disagree about each other's existence."
        )

    if args.list_problems:

        def print_list(title: str, items: list[tuple[int, int]]) -> None:
            if not items:
                return
            print(f"\n{title}:")
            for peer_id, detection_id in items[: args.list_limit]:
                print(f"  peer={peer_id} detection={detection_id}")
            if len(items) > args.list_limit:
                print(f"  ... and {len(items) - args.list_limit} more")

        print_list("Orphaned files", orphaned_files)
        print_list("Dangling DB rows", dangling_db)
        print_list("Not yet manifested", not_manifested)
        print_list("Stale manifest rows", stale_manifest)


def cmd_repair(env: dict[str, str], args: argparse.Namespace) -> None:
    """Reconciles manifest.db files against disk, in both directions: adds
    rows for clip files missing from their manifest, and removes rows whose
    clip file is gone. Delegates to reconcile_birdnet_manifest.py inside the
    controller container (it reuses the same manifest read/write functions
    the live upload path uses, which must stay there since that's also where
    they're used for every live clip upload). Doesn't touch disk/Postgres
    mismatches (orphaned files, dangling DB rows) -- those need a human call,
    not an automatic fix; see `audio-archive status`."""
    require_container_running(CONTROLLER_CONTAINER)
    result = subprocess.run(
        ["docker", "exec", CONTROLLER_CONTAINER, "python3", "reconcile_birdnet_manifest.py"]
    )
    if result.returncode != 0:
        die(f"repair failed (exit {result.returncode})")


def export_format(output: Path) -> str:
    name = output.name.lower()
    if name.endswith(".zip"):
        return "zip"
    if name.endswith(".tar.gz") or name.endswith(".tgz"):
        return "targz"
    return "dir"


def site_dirname(row: dict) -> str:
    label = row.get("site_label")
    if not label:
        return f"peer-{row['peer_id']}"
    safe = re.sub(r"[^A-Za-z0-9._-]+", "-", label).strip("-") or "site"
    return f"{safe}-{row['peer_id']}"


def manifest_row(row: dict, archive_path: str) -> dict:
    out = {field: row.get(field) for field in MANIFEST_FIELDS if field != "archive_path"}
    out["archive_path"] = archive_path
    return out


def manifest_csv_text(rows: list[dict]) -> str:
    buf = io.StringIO()
    writer = csv.DictWriter(buf, fieldnames=MANIFEST_FIELDS)
    writer.writeheader()
    for row in rows:
        writer.writerow(row)
    return buf.getvalue()


def environment_csv_text(rows: list[dict]) -> str:
    buf = io.StringIO()
    writer = csv.DictWriter(buf, fieldnames=ENVIRONMENT_FIELDS)
    writer.writeheader()
    for row in rows:
        writer.writerow({k: row.get(k) for k in ENVIRONMENT_FIELDS})
    return buf.getvalue()


def cmd_export(env: dict[str, str], args: argparse.Namespace) -> None:
    if not args.all and args.limit is None and not args.per_label:
        die(
            "export requires --limit N, --all, or --per-label N -- "
            "be explicit about how much you're archiving"
        )
    args.with_audio_only = True
    rows = fetch_rows(env, args)
    if not rows:
        print("No matching detections with an uploaded clip; nothing to export.")
        return

    audio_root = Path(env.get("BIRDNET_AUDIO_DATA_DIR") or DEFAULT_AUDIO_DIR)
    if not audio_root.is_dir():
        die(f"audio root not found at {audio_root} (check BIRDNET_AUDIO_DATA_DIR in {ENV_FILE})")

    environment_text = None
    if args.with_environment:
        environment_rows = fetch_environment(env, rows, args.env_window_minutes)
        environment_text = environment_csv_text(environment_rows)

    output = Path(args.output).expanduser()
    fmt = export_format(output)
    if fmt != "dir":
        output.parent.mkdir(parents=True, exist_ok=True)
    exported = 0
    missing = 0
    manifest_rows: list[dict] = []

    if fmt == "dir":
        output.mkdir(parents=True, exist_ok=True)
        clips_root = output / "clips"
        for row in rows:
            if not row.get("clip_path"):
                continue
            src = audio_root / row["clip_path"]
            if not src.is_file():
                missing += 1
                continue
            dest_dir = clips_root / site_dirname(row)
            dest_dir.mkdir(parents=True, exist_ok=True)
            dest = dest_dir / f"{row['detection_id']}.flac"
            shutil.copyfile(src, dest)
            manifest_rows.append(manifest_row(row, str(dest.relative_to(output))))
            exported += 1
        (output / "manifest.csv").write_text(manifest_csv_text(manifest_rows))
        if environment_text is not None:
            (output / "environment.csv").write_text(environment_text)
    elif fmt == "zip":
        with zipfile.ZipFile(output, "w", zipfile.ZIP_DEFLATED) as zf:
            for row in rows:
                if not row.get("clip_path"):
                    continue
                src = audio_root / row["clip_path"]
                if not src.is_file():
                    missing += 1
                    continue
                arcname = f"clips/{site_dirname(row)}/{row['detection_id']}.flac"
                zf.write(src, arcname)
                manifest_rows.append(manifest_row(row, arcname))
                exported += 1
            zf.writestr("manifest.csv", manifest_csv_text(manifest_rows))
            if environment_text is not None:
                zf.writestr("environment.csv", environment_text)
    else:  # targz
        with tarfile.open(output, "w:gz") as tf:
            for row in rows:
                if not row.get("clip_path"):
                    continue
                src = audio_root / row["clip_path"]
                if not src.is_file():
                    missing += 1
                    continue
                arcname = f"clips/{site_dirname(row)}/{row['detection_id']}.flac"
                tf.add(src, arcname=arcname)
                manifest_rows.append(manifest_row(row, arcname))
                exported += 1

            def add_text_member(name: str, text: str) -> None:
                data = text.encode("utf-8")
                info = tarfile.TarInfo(name)
                info.size = len(data)
                tf.addfile(info, io.BytesIO(data))

            add_text_member("manifest.csv", manifest_csv_text(manifest_rows))
            if environment_text is not None:
                add_text_member("environment.csv", environment_text)

    suffix = f" ({missing} missing file(s) skipped)" if missing else ""
    env_suffix = f", {len(environment_rows)} environment reading(s)" if args.with_environment else ""
    print(f"Exported {exported} clip(s) to {output}{suffix}{env_suffix}")


def add_selection_args(parser: argparse.ArgumentParser, *, default_limit: int | None) -> None:
    limit_help = "Max total rows" if default_limit is None else f"Max total rows (default: {default_limit})"
    if default_limit is None:
        limit_help += " (required unless --all or --per-label)"
    limit_help += "; combine with --per-label to cap the total while still guaranteeing per-label coverage"
    # --limit and --all are contradictory (a cap vs. no cap) so stay mutually
    # exclusive; --per-label is independent of both -- it sets a per-label
    # cap that composes with --limit/--all as an additional *global* cap on
    # top of it, not a replacement selection mode.
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--limit", type=int, default=default_limit, help=limit_help)
    group.add_argument("--all", action="store_true", help="No total row limit")
    parser.add_argument(
        "--per-label",
        type=int,
        help="Up to N examples per label (highest score first; weighted_label when present, "
        "else raw label). --limit (default shown above, if any) still applies as a cap on the "
        "total; pass --all to remove that total cap and keep only the per-label one",
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Query, subset, and archive the uploaded audio archive."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    query_parser = subparsers.add_parser("query", help="Print matching detections")
    add_filter_args(query_parser, with_audio_only_flag=True)
    add_selection_args(query_parser, default_limit=200)
    query_parser.add_argument("--format", choices=["table", "csv", "json"], default="table")
    query_parser.set_defaults(func=cmd_query)

    export_parser = subparsers.add_parser(
        "export", help="Copy matching clips + a manifest.csv into a directory, .zip, or .tar.gz"
    )
    # export always restricts to clips with audio regardless of this flag
    # (cmd_export forces it) -- accepted anyway since it's natural muscle
    # memory coming from `query`, and erroring on it would be surprising.
    add_filter_args(export_parser, with_audio_only_flag=True)
    add_selection_args(export_parser, default_limit=None)
    export_parser.add_argument(
        "--output",
        default=f"audio-export-{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}.tar.gz",
        help="Output path: a directory, or a file ending in .zip/.tar.gz/.tgz (default: timestamped .tar.gz in the current directory)",
    )
    export_parser.add_argument(
        "--with-environment",
        action="store_true",
        help="Also write environment.csv: i2c sensor readings (temperature, humidity, CO2, etc. -- "
        "whatever's attached per site) from each clip's site within --env-window-minutes of its clip_start_time",
    )
    export_parser.add_argument(
        "--env-window-minutes",
        type=float,
        default=15,
        help="With --with-environment, how far on either side of clip_start_time to match readings (default: 15)",
    )
    export_parser.set_defaults(func=cmd_export)

    labels_parser = subparsers.add_parser("labels", help="List distinct labels with detection counts")
    labels_parser.add_argument("--site", help="Peer id, UUID, WireGuard IP, or hostname")
    labels_parser.add_argument("--since", help="Only count clips starting at/after this time")
    labels_parser.add_argument("--until", help="Only count clips starting before this time")
    labels_parser.set_defaults(func=cmd_labels)

    status_parser = subparsers.add_parser(
        "status",
        help="Cross-check clip files on disk against Postgres and each peer's manifest.db",
    )
    status_parser.add_argument("--site", help="Peer id, UUID, WireGuard IP, or hostname (default: all sites)")
    status_parser.add_argument(
        "--list-problems", action="store_true", help="List the actual peer/detection ids, not just counts"
    )
    status_parser.add_argument(
        "--list-limit", type=int, default=50, help="Max ids printed per category with --list-problems (default: 50)"
    )
    status_parser.set_defaults(func=cmd_status)

    repair_parser = subparsers.add_parser(
        "repair",
        help="Reconcile manifest.db files against disk (add missing rows, prune stale ones)",
    )
    repair_parser.set_defaults(func=cmd_repair)

    args = parser.parse_args()

    require_docker()
    require_db_running()
    env = load_env()

    args.func(env, args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
